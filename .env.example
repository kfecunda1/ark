# ARK Inbox's Telegram bot (supabase/migrations/022_telegram_inbox.sql,
# app/api/telegram/inbox/route.ts) — separate from any other Telegram
# bot. Set these in .env.local for local dev and in Vercel's project
# env vars for production; never commit real values.
ARK_TELEGRAM_BOT_TOKEN=
ARK_TELEGRAM_WEBHOOK_SECRET=

# Morning briefing cron (vercel.json, app/api/cron/morning-briefing/
# route.ts) — Vercel automatically sends this as the request's
# Authorization: Bearer header when it's set as a project env var, so
# nothing else needs to reference it directly.
CRON_SECRET=
